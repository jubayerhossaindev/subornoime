# libFuzzer dictionary for suborno_phonetic_fuzz
# Tokens mirror the phonetic key inventory used by the Smart/Classic/Probhat
# profiles (see docs/specifications/phonetic-mapping-spec.md). libFuzzer
# mutates around these tokens instead of random bytes, reaching deep parser
# states (conjuncts, vowel signs, case mixes) far faster.
#
# Vowels and vowel signs
"k="a""
"aa"
"i="i""
"ee"
"u="u""
"oo"
"e="e""
"oi"
"ou"
"o="o""
"rri"
# Common consonants
"k="k""
"kh"
"g="g""
"gh"
"ng"
"ch"
"chh"
"j="j""
"t="t""
"th"
"d="d""
"dh"
"n="n""
"p="p""
"f="f""
"b="b""
"bh"
"v="v""
"m="m""
"z="z""
"r="r""
"rr"
"l="l""
"sh"
"ss"
"s="s""
"h="h""
"tth"
"ddh"
# Structural stressors
" "
"\x0A"
"-"
"."
"0"
"A"
"Z"
